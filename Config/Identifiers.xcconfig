// OffRent Ledger — the one place identifiers live.
//
// Every target's build settings reference these variables. Changing the bundle prefix, the
// display name or the deployment target is a single edit here, and `scripts/verify_repository.py`
// fails the build if a Swift file or a plist hardcodes one of them instead.

// MARK: - Identity

OFFRENT_DISPLAY_NAME = OffRent Ledger
OFFRENT_COMPANY = Idlery Services LLC

// The working name is centralised so it can change without a broad rewrite. If the App Store name
// changes, this line and `AppConfiguration.displayName` are the edit.

// MARK: - Bundle identifiers

OFFRENT_BUNDLE_PREFIX = com.idlery.offrent
OFFRENT_BUNDLE_ID = $(OFFRENT_BUNDLE_PREFIX)
OFFRENT_WIDGET_BUNDLE_ID = $(OFFRENT_BUNDLE_PREFIX).widget
OFFRENT_TESTS_BUNDLE_ID = $(OFFRENT_BUNDLE_PREFIX).tests
OFFRENT_UITESTS_BUNDLE_ID = $(OFFRENT_BUNDLE_PREFIX).uitests

// Must match OffRentShared/SharedIdentifiers.swift and both .entitlements files.
OFFRENT_APP_GROUP = group.$(OFFRENT_BUNDLE_PREFIX)

// Must match OffRentShared/SharedIdentifiers.swift and the app Info.plist.
OFFRENT_URL_SCHEME = offrent

// MARK: - Versioning

OFFRENT_MARKETING_VERSION = 1.0
OFFRENT_BUILD_NUMBER = 1

// MARK: - Platform

// iPhone only for v1. "1" is iPhone; adding "2" would ship an untested iPad layout.
OFFRENT_DEVICE_FAMILY = 1,2
OFFRENT_DEPLOYMENT_TARGET = 18.0

// MARK: - Signing
//
// UNVERIFIED. This value was read from the owner's existing CoreCredit project in the same
// workspace — it is not invented — but it has NOT been checked against an App Store Connect
// record for OffRent Ledger, and no App ID, provisioning profile or app record has been created.
// See RELEASE_CHECKLIST.md §3.
OFFRENT_DEVELOPMENT_TEAM = 7GNFT94A9L

// MARK: - Permission purpose strings
//
// Kept here so the reason the app asks matches the reason it actually uses, and so a reviewer can
// read all three in one place.

OFFRENT_CAMERA_USAGE = OffRent Ledger uses the camera only when you tap a scan or photo button, to scan a rental contract or invoice and to photograph equipment condition, meters and fuel gauges. Scanning and text recognition happen entirely on this iPhone. Nothing is uploaded.
OFFRENT_LOCATION_USAGE = OffRent Ledger asks for your location only when you tap "Add current location" while recording an off-rent confirmation or a pickup, so the record shows where the equipment was. It is captured once, in the foreground, and is never tracked in the background.
