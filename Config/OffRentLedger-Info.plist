<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>$(OFFRENT_DISPLAY_NAME)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
	  UILaunchScreen is the screen iOS paints the instant the process starts, before a single
	  line of SwiftUI runs. It stops the app opening on a white flash. It takes a colour and an
	  image and nothing else — no text, no layout — so the "Powered by Idlery" line comes from
	  LaunchSplashView, which draws the same colour and the same mark at the same fraction and
	  then fades away.

	  INFOPLIST_KEY_UILaunchScreen_Generation must stay OFF in the build settings. It generates
	  an empty UILaunchScreen dictionary, and a generated key is merged on top of this file —
	  which would silently replace everything below with nothing.
	-->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<!-- The orange tag on a transparent square canvas, occupying the same fraction of it
		     that LaunchSplashView.markFraction draws. Same asset, same proportion, so the two
		     layers cannot drift apart. -->
		<key>UIImageName</key>
		<string>LaunchMark</string>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!--
	  iPad supports all four orientations. It has to: there is no UIRequiresFullScreen key in
	  this file, so the app is eligible for Split View and Slide Over, and iPadOS will only put
	  a multitasking app on screen if it can follow the window into every orientation. A
	  portrait-only iPad app is also rejected on sight in App Review's iPad pass.

	  Portrait-upside-down is listed for iPad only. On iPhone it is deliberately absent — a
	  phone that flips upside down puts the sticky Save bar over the home indicator.
	-->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(OFFRENT_BUNDLE_ID)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(OFFRENT_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>$(OFFRENT_CAMERA_USAGE)</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>$(OFFRENT_LOCATION_USAGE)</string>
	<key>UIBackgroundModes</key>
	<array/>
	<key>NSSupportsLiveActivities</key>
	<false/>
</dict>
</plist>
